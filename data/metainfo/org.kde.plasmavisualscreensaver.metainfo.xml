  <name>Plasma Visual Screensaver</name>
  <summary>A non-locking visual screensaver for Plasma Wayland</summary>
  <description>
    <p>Displays low-resource animated visuals and a clock across every monitor after a configurable idle interval.</p>
    <p>This application is decorative and is not a security boundary.</p>
  </description>
  <launchable type="desktop-id">org.kde.plasmavisualscreensaver.desktop</launchable>
  <url type="homepage">https://github.com/StantonMatt/plasma-wayland-screensaver</url>
  <url type="bugtracker">https://github.com/StantonMatt/plasma-wayland-screensaver/issues</url>
