#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export DEB_CXXFLAGS_MAINT_APPEND = -Wformat -Werror=format-security
export CARGO_HOME = $(CURDIR)/obj-$(DEB_HOST_GNU_TYPE)/cargo-home
export CARGO_NET_OFFLINE = true
export RUSTFLAGS = $(shell dpkg-buildflags --get RUSTFLAGS)
include /usr/share/dpkg/architecture.mk

%:
	dh $@ --buildsystem=cmake+ninja

override_dh_auto_configure:
	dh_auto_configure -- -DCMAKE_BUILD_TYPE=None -DBUILD_TESTING=ON \
		-DCARGO_EXECUTABLE=/usr/bin/cargo -DRUSTC_EXECUTABLE=/usr/bin/rustc -DRUSTDOC_EXECUTABLE=/usr/bin/rustdoc

override_dh_auto_install:
	dh_auto_install
	rm -f debian/plasma-visual-screensaver/usr/share/doc/plasma-visual-screensaver/changelog.Debian.gz
	rm -f debian/plasma-visual-screensaver/usr/share/doc/plasma-visual-screensaver/copyright

override_dh_auto_test:
	QT_QPA_PLATFORM=offscreen dh_auto_test --no-parallel

override_dh_gencontrol:
	static_built_using="$$(./packaging/debian/rust-static-built-using.sh /usr/bin/rustc)" && \
		dh_gencontrol -- -Vrust:Static-Built-Using="$$static_built_using"
